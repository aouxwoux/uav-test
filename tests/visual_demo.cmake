# OUTPUT is a dedicated directory under this project's build directory.
if(EXISTS "${OUTPUT}")
  message(FATAL_ERROR "Demo fixture already exists: ${OUTPUT}")
endif()
execute_process(COMMAND "${DEMO_EXE}" "${OUTPUT}" RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Visual demo failed: ${log}\n${errors}")
endif()
file(READ "${OUTPUT}/report.html" html)
foreach(required "case0" "case1" "case2" "case3" "results.csv" "prediction-0.png" "no fix")
  string(FIND "${html}" "${required}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Report is missing ${required}")
  endif()
endforeach()
foreach(asset "prediction-0.png" "prediction-1.png" "prediction-2.png" "prediction-3.png" "results.csv")
  if(NOT EXISTS "${OUTPUT}/${asset}")
    message(FATAL_ERROR "Missing report asset ${asset}")
  endif()
endforeach()
execute_process(COMMAND "${DEMO_EXE}" "${OUTPUT}" RESULT_VARIABLE second OUTPUT_QUIET ERROR_QUIET)
if(second EQUAL 0)
  message(FATAL_ERROR "Demo overwrote an existing output folder")
endif()
file(REMOVE_RECURSE "${OUTPUT}")
message(STATUS "Visual demo, result assertions, report assets, and overwrite protection passed")
